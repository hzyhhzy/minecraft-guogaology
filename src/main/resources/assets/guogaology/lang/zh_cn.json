  "advancement.guogaology.guide.landmark_frontier.title": "探索界限演算庭",
  "advancement.guogaology.guide.landmark_frontier.description": "进入界限演算庭的建筑空间，探索它的通路与主题陈列。",
  "advancement.guogaology.guide.landmark_guogao.title": "探索果糕终境巨树",
  "advancement.guogaology.guide.landmark_guogao.description": "进入果糕终境巨树的建筑空间，探索它的通路与主题陈列。",
  "advancement.guogaology.guide.landmarks_all.title": "八种巨构",
  "advancement.guogaology.guide.landmarks_all.description": "进入八种巨构各自的建筑空间；无需开启箱子。",
  "item.guogaology.guide_emblem": "果糕逻辑探索指引",
  "advancement.guogaology.guide.first_omega.title": "通往里界的Ω",
  "advancement.guogaology.guide.first_omega.description": "获得第一份Ω序数结晶或一块Ω矿石。前往里界的矿物门，需要投入一份Ω材料激活。",
  "advancement.guogaology.guide.ordinal1.title": "晶体中的结构",
  "advancement.guogaology.guide.ordinal1.description": "九块普通序数晶体凝为一级序数晶核。装入手稿可加强攻击、防护、已有治疗和果糕状态持续时间。",
  "advancement.guogaology.guide.ordinal2.title": "结构中的层次",
  "advancement.guogaology.guide.ordinal2.description": "九合一取得二级序数晶核，继续加强手稿中的综合加成。",
  "advancement.guogaology.guide.biome_matrix.title": "走进矩阵山脉",
  "advancement.guogaology.guide.biome_matrix.description": "进入里界的矩阵山脉，寻找本地材料与巨构。",
  "advancement.guogaology.guide.material_matrix.title": "折峰之间的一页",
  "advancement.guogaology.guide.material_matrix.description": "从山脉晶页采集矩阵薄片。平面的矩阵，也能展开成立体山脉。",
  "advancement.guogaology.guide.core_matrix_1.title": "多挖一格",
  "advancement.guogaology.guide.core_matrix_1.description": "获得1级矩阵晶核。镶入镐可额外开采；装入手稿则同时增加挖速加值和急迫乘区。",
  "advancement.guogaology.guide.core_matrix_2.title": "并行开采",
  "advancement.guogaology.guide.core_matrix_2.description": "获得2级矩阵晶核。更高阶的矩阵扩大额外开采能力，也加强手稿的两项挖速。",
  "advancement.guogaology.guide.core_matrix_3.title": "矩阵展开",
  "advancement.guogaology.guide.core_matrix_3.description": "获得3级矩阵晶核。将开采能力推进到三级；额外开采不会向选中方块下方延伸。",
  "advancement.guogaology.guide.biome_power.title": "走进幂塔荒漠",
  "advancement.guogaology.guide.biome_power.description": "进入里界的幂塔荒漠，寻找本地材料与巨构。",
  "advancement.guogaology.guide.material_power.title": "箭头与三色枝端",
  "advancement.guogaology.guide.material_power.description": "收集幂塔铭木与任一种TREE彩色节点，辨认荒漠中箭头、树与图的踪迹。",
  "advancement.guogaology.guide.core_power_1.title": "箭头的锋芒",
  "advancement.guogaology.guide.core_power_1.description": "获得1级幂塔晶核。镶入剑、弓或手稿可加强攻击，武器与手稿分别计入。",
  "advancement.guogaology.guide.core_power_2.title": "力量迭代",
  "advancement.guogaology.guide.core_power_2.description": "获得2级幂塔晶核。将攻击晶核推进到二级；同一物品上的同类加成平方求和开根号。",
  "advancement.guogaology.guide.core_power_3.title": "幂塔升阶",
  "advancement.guogaology.guide.core_power_3.description": "获得3级幂塔晶核。三级幂塔进一步加强攻击，在里界与地府表现为更强的独立乘区。",
  "advancement.guogaology.guide.biome_hydra.title": "走进序数花园",
  "advancement.guogaology.guide.biome_hydra.description": "进入里界的序数花园，寻找本地材料与巨构。",
  "advancement.guogaology.guide.material_hydra.title": "剪下一枝，不斩九头",
  "advancement.guogaology.guide.material_hydra.description": "采集Hydra芽穗，观察树状分枝；这里的Hydra是景观植物。",
  "advancement.guogaology.guide.core_hydra_1.title": "更多的收获",
  "advancement.guogaology.guide.core_hydra_1.description": "获得1级分枝芽核。镐获得时运II并可切换精准采集；剑对应抢夺，弓对应无限，手稿延长触距。",
  "advancement.guogaology.guide.core_hydra_2.title": "一枝化多枝",
  "advancement.guogaology.guide.core_hydra_2.description": "获得2级分枝芽核。二级提升时运与抢夺，并让弓获得多重射击。",
  "advancement.guogaology.guide.core_hydra_3.title": "枝端之外",
  "advancement.guogaology.guide.core_hydra_3.description": "获得3级分枝芽核。三级提供更高时运与抢夺、弓的穿透，或更远的手稿触距。",
  "advancement.guogaology.guide.biome_absence.title": "走进LHO 空无之境",
  "advancement.guogaology.guide.biome_absence.description": "进入里界的LHO 空无之境，寻找本地材料与巨构。",
  "advancement.guogaology.guide.material_absence.title": "让虚无停留",
  "advancement.guogaology.guide.material_absence.description": "普通序数晶体稳定周围两圈，即5×5×5范围；ψ、Z、fffZ、FOS会变色。收集一枚这些材料和一块普通晶体。",
  "advancement.guogaology.guide.core_absence_1.title": "存在感渐淡",
  "advancement.guogaology.guide.core_absence_1.description": "获得1级空无晶核。装入手稿后，普通野怪的主动索敌距离缩短；装入装备则保护耐久。",
  "advancement.guogaology.guide.core_absence_2.title": "无人留意",
  "advancement.guogaology.guide.core_absence_2.description": "获得2级空无晶核。手稿使普通野怪不再主动索敌，并提供夜视；特殊索敌机制仍保留。",
  "advancement.guogaology.guide.core_absence_3.title": "无声的回击",
  "advancement.guogaology.guide.core_absence_3.description": "获得3级空无晶核。手稿连普通报复索敌也不再触发；装备上的耐久保护更强。",
  "advancement.guogaology.guide.biome_weaver.title": "走进紫菜桌高原",
  "advancement.guogaology.guide.biome_weaver.description": "进入里界的紫菜桌高原，寻找本地材料与巨构。",
  "advancement.guogaology.guide.material_weaver.title": "紫菜与软糖之间",
  "advancement.guogaology.guide.material_weaver.description": "从紫菜植株收集紫菜薄片；镶边石旁通向数字砖的一行图案可以弹奏。",
  "advancement.guogaology.guide.core_weaver_1.title": "潮声与回响",
  "advancement.guogaology.guide.core_weaver_1.description": "获得1级紫菜凝核。头盔减少耗氧并提供水下速掘，靴子改善水中移动；手稿每4秒治疗。",
  "advancement.guogaology.guide.core_weaver_2.title": "水下亦从容",
  "advancement.guogaology.guide.core_weaver_2.description": "获得2级紫菜凝核。二级继续加强水下能力；手稿同时提供治疗与饥饿下限保障。",
  "advancement.guogaology.guide.core_weaver_3.title": "深水无息",
  "advancement.guogaology.guide.core_weaver_3.description": "获得3级紫菜凝核。三级头盔不再耗氧，靴子提供更强水中移动；手稿治疗与饥饿保障也升级。",
  "advancement.guogaology.guide.biome_astra.title": "走进Astra 推演原",
  "advancement.guogaology.guide.biome_astra.description": "进入里界的Astra 推演原，寻找本地材料与巨构。",
  "advancement.guogaology.guide.material_astra.title": "云中的算力",
  "advancement.guogaology.guide.material_astra.description": "在蘑菇云内部寻找核爆晶块，或采集扭结中心的晶块；拆取机柜获得算力芯片。",
  "advancement.guogaology.guide.core_astra_1.title": "震撼的一击",
  "advancement.guogaology.guide.core_astra_1.description": "获得1级核爆之心。装入剑或弓，命中会对目标与附近生物产生爆裂伤害，不破坏地形。",
  "advancement.guogaology.guide.core_astra_2.title": "连锁的余波",
  "advancement.guogaology.guide.core_astra_2.description": "获得2级核爆之心。二级加强命中的爆裂；核爆之心不适用于手稿。",
  "advancement.guogaology.guide.core_astra_3.title": "临界已至",
  "advancement.guogaology.guide.core_astra_3.description": "获得3级核爆之心。三级爆裂更强；多颗同核的爆裂比例平方求和开根号。",
  "advancement.guogaology.guide.biome_frontier.title": "走进界限高原",
  "advancement.guogaology.guide.biome_frontier.description": "进入里界的界限高原，寻找本地材料与巨构。",
  "advancement.guogaology.guide.material_frontier.title": "集合与纸带的边缘",
  "advancement.guogaology.guide.material_frontier.description": "收集集合膜或图灵终符，观察集合晶壳与长纸带。",
  "advancement.guogaology.guide.core_frontier_1.title": "落地从容",
  "advancement.guogaology.guide.core_frontier_1.description": "获得1级界限晶核。护甲提供额外防护；手稿降低摔落与撞击伤害、提高安全摔落高度，并增加跳高与步速。",
  "advancement.guogaology.guide.core_frontier_2.title": "离地而行",
  "advancement.guogaology.guide.core_frontier_2.description": "获得2级界限晶核。装入手稿可切换缓速飞行，并获得防火；护甲仍用于防护。",
  "advancement.guogaology.guide.core_frontier_3.title": "越过界限",
  "advancement.guogaology.guide.core_frontier_3.description": "获得3级界限晶核。装入手稿可自由飞行并冲刺；里界与地府的冲刺飞行更快。",
  "advancement.guogaology.guide.material_guogao.title": "藏在表情里的馃槹",
  "advancement.guogaology.guide.material_guogao.description": "在圣诞树星星内部与终境巨树的外挂表情球中心寻找馃槹，并收集果糕凝胶。馃槹略带圆角，六面使用原生32×32纹理、约28×28的焦虑流汗表情区，亮度15。",
  "advancement.guogaology.guide.core_guogao_1.title": "令人流汗",
  "advancement.guogaology.guide.core_guogao_1.description": "获得1级果糕之心。剑与弓使目标缓慢、中毒；手稿增加生命，装备护甲本身不直接加生命。",
  "advancement.guogaology.guide.core_guogao_2.title": "诡异开始蔓延",
  "advancement.guogaology.guide.core_guogao_2.description": "获得2级果糕之心。武器施加更强负面状态；手稿增加生命、免疫部分状态，并优先使用背包图腾保命。",
  "advancement.guogaology.guide.core_guogao_3.title": "难以直视",
  "advancement.guogaology.guide.core_guogao_3.description": "获得3级果糕之心。三级武器可使目标凋零、虚弱、反胃并有概率失明；手稿强化生命与状态免疫。",
  "advancement.guogaology.guide.eat_guogao.title": "尝一口果糕",
  "advancement.guogaology.guide.eat_guogao.description": "吃下一片果糕切片。",
  "advancement.guogaology.guide.play_laver.title": "桌边的一声",
  "advancement.guogaology.guide.play_laver.description": "不潜行时右键镶边石（手持物品也可），弹奏通向矩阵数字砖的最长一行桌格，每格四分之一秒。",
  "advancement.guogaology.guide.omega_mastery.title": "Ω，全部展开",
  "advancement.guogaology.guide.omega_mastery.description": "穿戴四件Ω护甲并手持Ω手稿；五件共38槽均镶入兼容的满级晶核。图腾、空槽与未生效的编辑不计。",
  "item.guogaology.landmark_emblem_matrix": "矩阵折峰堡探索标志",
  "item.guogaology.landmark_emblem_power": "迭代圆木塔探索标志",
  "item.guogaology.landmark_emblem_hydra": "六枝冠庭探索标志",
  "item.guogaology.landmark_emblem_absence": "缺页悬空回廊探索标志",
  "item.guogaology.landmark_emblem_weaver": "紫菜三角宫探索标志",
  "item.guogaology.landmark_emblem_astra": "Astra 推演中枢探索标志",
  "item.guogaology.landmark_emblem_frontier": "界限演算庭探索标志",
  "item.guogaology.landmark_emblem_guogao": "果糕终境巨树探索标志",
  "item.guogaology.brand_emblem": "果糕逻辑标志",
  "item.guogaology.lho_guide_emblem": "LHO空无之境标志",
  "block.guogaology.guogao_drop": "馃槹",
  "gui.guogaology.recipebook.cores": "晶核",
  "gui.guogaology.recipebook.ggg": "GGG"
