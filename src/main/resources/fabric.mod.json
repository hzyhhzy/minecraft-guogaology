{
  "schemaVersion": 1,
  "id": "googology",
  "version": "${version}",
  "name": "果糕逻辑 · Guogaology",
  "description": "Explore Outer Googology, monumental Inner Googology and the Guogao Underworld. Four ordinal minerals, shared equipment, crystal upgrades, passive Denxi Manuscripts and seven outer-world creatures.\n\n探索大数表界、巨构里界与果糕地府。四档序数矿物与装备、晶核强化、被动扽西手稿，以及七类表界生物。",
  "authors": [
    "Sigmoid"
  ],
  "license": "GPL-3.0-only WITH GPL-3.0-linking-exception",
  "icon": "assets/googology/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.googology.GoogologyMod"
    ],
    "client": [
      "dev.googology.client.GoogologyClient"
    ]
  },
  "mixins": [
    "googology.mixins.json",
    {
      "config": "googology.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.102.0"
  },
  "contact": {
    "homepage": "https://github.com/hzyhhzy/minecraft-guogaology",
    "sources": "https://github.com/hzyhhzy/minecraft-guogaology",
    "issues": "https://github.com/hzyhhzy/minecraft-guogaology/issues"
  },
  "jars": [
    {
      "file": "META-INF/jars/guogaology-outer-legacy-${version}.jar"
    }
  ]
}
